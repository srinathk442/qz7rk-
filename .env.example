# Copy to .env (git-ignored). Docker Compose reads it from this folder; for the
# backend on its own, copy it to backend/.env and run uvicorn with --env-file .env.

# Signs login tokens. Required on Vercel; at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset locally, a random secret is used and logins end when the server restarts.
JWT_SECRET=

# How long a login lasts, in hours.
JWT_TTL_HOURS=12

# User accounts database. Defaults to SQLite (backend/users.db). Use Postgres on
# Vercel, whose filesystem is wiped between invocations, e.g.
#   DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=
