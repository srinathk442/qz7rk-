{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/app,backend/data,frontend/dist}/**",
      "excludeFiles": "{frontend/node_modules,frontend/src,backend/tests}/**"
    }
  }
}
